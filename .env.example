# Medusa backend (see backend/). Leave both empty to run on the bundled
# catalog (src/data/catalog.json) with local cart/account/payment stand-ins.
PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000
# Printed by the backend seed ("Publishable API key: pk_..."), or
# Admin > Settings > Publishable API Keys.
PUBLIC_MEDUSA_PUBLISHABLE_KEY=
# Optional: skip the region lookup.
PUBLIC_MEDUSA_REGION_ID=
# Optional: Stripe publishable key. When set, checkout uses Medusa's Stripe
# provider (pp_stripe_stripe) instead of the system provider.
PUBLIC_STRIPE_PUBLISHABLE_KEY=
