---
import type { Collection } from '@/lib/types';
import ChipList from './ChipList.astro';

interface Chip {
  t: string;
  h: string;
}

interface Props {
  collection: Collection;
  parent?: Collection;
  parentHref?: string;
  chips: Chip[];
  chipsLabel: string;
  /** "ALL SALES ARE FINAL" pill (clearance) */
  finalSale?: boolean;
}

const { collection: c, parent, parentHref, chips, chipsLabel, finalSale = false } = Astro.props;
const crumbLink = 'text-ink-300 underline underline-offset-2 hover:text-fog';
// Desktop: chips sit in the dark band. Mobile: a scroll row on the light page below it.
const bandChips = {
  cls: 'hidden lg:flex lg:max-w-[520px] lg:flex-[0_1_auto] lg:flex-wrap lg:justify-end',
  chipCls: 'border-line-dark text-[#F6F8F8] hover:border-line-dark-strong hover:bg-ink-850 hover:text-[#F6F8F8]',
};
const lightChips = {
  cls: 'flex overflow-x-auto px-4 pb-4 [scrollbar-width:none] lg:hidden [&::-webkit-scrollbar]:hidden',
  chipCls: 'border-line-strong text-ink-900 hover:border-ink-900 hover:text-ink-900',
};
---

<div class="dark-band bg-ink-950 pb-2 text-[#F6F8F8]">
  <div class="container-page">
    <nav aria-label="Breadcrumb" class="pt-4 lg:pt-6">
      <ol class="m-0 flex list-none flex-wrap items-center gap-1.5 p-0 text-[13px] text-ink-300 lg:gap-2 lg:text-sm">
        <li><a href="/" class={crumbLink}>Home</a></li>
        <li aria-hidden="true">/</li>
        {parent && parentHref && (
          <>
            <li><a href={parentHref} class={crumbLink}>{parent.title}</a></li>
            <li aria-hidden="true">/</li>
          </>
        )}
        <li aria-current="page" class="font-bold text-[#F6F8F8]">{c.title}</li>
      </ol>
    </nav>

    <header class="flex flex-col gap-2.5 pt-3 pb-5 lg:flex-row lg:flex-wrap lg:items-end lg:justify-between lg:gap-6 lg:pt-7 lg:pb-8">
      <div class="flex min-w-0 flex-col gap-2.5 lg:max-w-[720px] lg:flex-[1_1_520px] lg:gap-3.5">
        {finalSale && (
          <span class="self-start rounded-sm bg-[rgba(255,143,163,0.12)] px-2.5 py-1 text-xs font-extrabold tracking-[0.04em] text-sale-300">ALL SALES ARE FINAL</span>
        )}
        <h1 class="m-0 font-display text-[38px] leading-none font-extrabold tracking-[-0.07em] text-balance lg:text-[56px]">{c.title}</h1>
        <p
          id="cp-intro"
          data-cp-intro
          class="m-0 line-clamp-3 text-[15px] leading-[23px] text-pretty text-fog lg:line-clamp-none lg:text-[17px] lg:leading-[27px]"
        >
          {c.intro}
        </p>
        <button
          type="button"
          data-cp-intro-toggle
          hidden
          aria-controls="cp-intro"
          aria-expanded="false"
          class="self-start border-0 bg-transparent py-1.5 text-sm font-bold text-cyan-400 underline hover:text-cyan-300 lg:hidden"
        >
          Read more
        </button>
      </div>

      {chips.length > 0 && <ChipList chips={chips} label={chipsLabel} {...bandChips} />}
    </header>
  </div>
</div>

{chips.length > 0 && (
  <div class="container-page lg:hidden">
    <div class="-mx-4 pt-4">
      <ChipList chips={chips} label={chipsLabel} {...lightChips} />
    </div>
  </div>
)}

<script>
  // Mobile: intro clamps to 3 lines; "Read more" shows only when it overflows.
  for (const btn of document.querySelectorAll<HTMLButtonElement>('[data-cp-intro-toggle]')) {
    const p = document.getElementById(btn.getAttribute('aria-controls') ?? '');
    if (!p) continue;
    const check = () => {
      if (btn.getAttribute('aria-expanded') === 'true') return;
      btn.hidden = p.scrollHeight <= p.clientHeight + 1;
    };
    check();
    window.addEventListener('resize', check, { passive: true });
    btn.addEventListener('click', () => {
      const open = btn.getAttribute('aria-expanded') !== 'true';
      btn.setAttribute('aria-expanded', String(open));
      p.style.display = open ? 'block' : '';
      btn.textContent = open ? 'Read less' : 'Read more';
    });
  }
</script>
