---
// v2 product card (ProductCard board). Keep in sync with collection/ProductCardReact.tsx.
import QuickAdd from './react/QuickAdd';
import Icon from './Icon.astro';
import { cardCategory, isOnSale } from '@/lib/catalog';
import { formatShort, priceLabel } from '@/lib/money';
import { cardImages, sized, toCartLine } from '@/lib/product';
import { productUrl } from '@/lib/routes';
import type { Product } from '@/lib/types';

interface Props {
  product: Product;
  /** eager-load the first image (above the fold) */
  eager?: boolean;
  badge?: 'new';
  /** override the mono category label */
  cat?: string;
  class?: string;
}

const { product: p, eager = false, badge, cat, class: className } = Astro.props;
const href = productUrl(p.handle);
const sale = isOnSale(p) && p.available;
const soldOut = !p.available;
const [img1, img2] = cardImages(p);
const single = p.variants.length === 1;
const line = single ? toCartLine(p, p.variants[0]) : null;
const label = cat ?? cardCategory(p);
---

<article class:list={['group/card flex h-full min-w-0 flex-col overflow-hidden rounded-card border border-[#D9E1E0] bg-surface text-ink-900 transition-colors duration-150 hover:border-ink-900 focus-within:border-ink-900', className]}>
  <a href={href} aria-label={p.title} class="relative flex aspect-square items-center justify-center bg-tile transition-colors duration-150 group-hover/card:bg-tile-hover">
    {img1 && (
      <img
        src={sized(img1.url, 600)}
        alt={p.title}
        loading={eager ? 'eager' : 'lazy'}
        decoding="async"
        width="600"
        height="600"
        class:list={[
          'product-shot absolute inset-0 size-full px-[9%] pt-[13%] pb-[7%] transition-[transform,opacity] duration-200',
          soldOut && 'opacity-45',
          img2 ? 'group-hover/card:opacity-0' : 'group-hover/card:scale-105',
        ]}
      />
    )}
    {img2 && (
      <img
        src={sized(img2.url, 600)}
        alt=""
        loading="lazy"
        decoding="async"
        width="600"
        height="600"
        class="product-shot absolute inset-0 size-full px-[9%] pt-[13%] pb-[7%] opacity-0 transition-opacity duration-150 group-hover/card:opacity-100"
      />
    )}
    <span class="absolute inset-x-2.5 top-2.5 flex items-center justify-between gap-1.5">
      <span class="font-mono text-[10px] font-semibold tracking-[0.08em] text-[#2B464E] uppercase">{label}</span>
      <span class="flex gap-1">
        {sale && <span class="rounded-xs bg-sale-600 px-[7px] py-[3px] font-mono text-[10px] font-bold tracking-[0.08em] text-white uppercase">Sale</span>}
        {badge === 'new' && <span class="rounded-xs bg-cyan-400 px-[7px] py-[3px] font-mono text-[10px] font-bold tracking-[0.08em] text-ink-950 uppercase">New</span>}
        {soldOut && <span class="rounded-xs bg-ink-900 px-[7px] py-[3px] font-mono text-[10px] font-bold tracking-[0.08em] text-white uppercase">Sold out</span>}
      </span>
    </span>
  </a>
  <div class="flex flex-1 flex-col gap-1.5 px-3.5 pt-3.5 pb-4">
    <a href={href} class="text-h4 font-extrabold text-pretty text-ink-900 no-underline group-hover/card:underline hover:text-ink-900">{p.title}</a>
    <div class="flex flex-wrap items-baseline gap-1.5">
      <span class:list={['text-sm font-extrabold', sale ? 'text-sale-600' : 'text-teal-700']}>{priceLabel(p.minPrice, p.maxPrice)} <span class="text-[9px] font-bold tracking-[0.04em]">USD</span></span>
      {sale && p.compareAtPrice && <s class="text-[13px] text-ink-500">{formatShort(p.compareAtPrice)}</s>}
    </div>
    <div class="mt-auto flex min-h-9 flex-wrap items-center justify-between gap-2 pt-2.5">
      <a href={href} class="flex items-center gap-1.5 text-[13px] font-extrabold text-ink-900 no-underline hover:text-ink-900">
        {single ? 'View product' : 'View options'}
        <Icon name="arrow-right" size={13} stroke={2.6} class="transition-transform duration-150 group-hover/card:translate-x-0.5" />
      </a>
      {soldOut ? <span class="text-xs font-bold text-ink-500">Sold out</span> : line && <QuickAdd client:visible line={line} />}
    </div>
  </div>
</article>
