---
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import SearchBox from './react/SearchBox';
import CartButton from './react/CartButton';
import { MEGA_COLUMNS, NAV_V2, menuHref, PAGES, collectionUrl } from '@/lib/routes';
import { STORE, PROMO } from '@/lib/commerce';
---

<header class="dark-band relative z-40 w-full bg-ink-850 text-[#F6F8F8]">
  <!-- Announcement bar -->
  <div class="bg-cyan-300 text-ink-950">
    <div class="container-page hidden h-[34px] items-center justify-between gap-4 text-[13px] leading-[18px] lg:flex">
      <span class="flex flex-1 items-center gap-2 font-bold text-teal-800">
        <Icon name="phone" size={15} stroke={2.2} />
        <a href={STORE.phoneHref} class="text-inherit no-underline hover:text-inherit">{STORE.phone}</a>
      </span>
      <p class="flex items-center gap-2.5 font-extrabold whitespace-nowrap">
        <Icon name="globe" size={15} stroke={2.2} />
        We ship across the US
        <span aria-hidden="true" class="opacity-50">·</span>
        <a href={PAGES.shipping} class="flex items-center gap-1 text-inherit no-underline hover:text-inherit hover:underline">Shipping details <Icon name="arrow-up-right" size={12} stroke={2.6} /></a>
      </p>
      <span class="flex flex-1 items-center justify-end gap-2 font-bold text-teal-800">
        Flash sale: 7% off $3,500+
        <code class="rounded-xs bg-ink-950 px-1.5 py-px font-mono text-[11px] font-semibold tracking-[0.04em] text-cyan-300">{PROMO.code}</code>
      </span>
    </div>
    <p class="flex items-center justify-center gap-2 px-4 py-2 text-xs leading-4 font-extrabold lg:hidden">
      <Icon name="globe" size={14} stroke={2.2} />
      We ship across the US <span aria-hidden="true" class="opacity-50">·</span>
      <a href={PAGES.shipping} class="text-inherit no-underline hover:text-inherit">Shipping details ↗</a>
    </p>
  </div>

  <!-- Desktop main bar -->
  <div class="hidden border-b border-line-dark lg:block" data-mega-root>
    <div class="container-page flex h-[72px] items-center gap-6">
      <div class="flex flex-1 basis-0"><Logo /></div>

      <nav aria-label="Main">
        <ul class="flex items-center gap-1">
          <li>
            <button
              type="button"
              aria-expanded="false"
              aria-controls="mega"
              data-mega-trigger
              class="flex h-10 items-center gap-1.5 rounded-md px-3 text-sm font-[750] text-[#DBE2E4] transition-colors duration-150 hover:bg-ink-800 aria-expanded:bg-cyan-400 aria-expanded:text-ink-950"
            >
              Shop all
              <Icon name="chevron-down" size={15} stroke={2.6} class="transition-transform duration-150 [[aria-expanded=true]>&]:rotate-180" />
            </button>
          </li>
          {NAV_V2.map(([t, h]) => (
            <li class:list={[t === 'System packages' && 'hidden xl:block']}>
              <a href={h} class="flex h-10 items-center rounded-md px-3 text-sm font-[750] whitespace-nowrap text-[#DBE2E4] no-underline hover:bg-ink-800 hover:text-white">{t}</a>
            </li>
          ))}
        </ul>
      </nav>

      <div class="flex flex-1 basis-0 items-center justify-end gap-1">
        <button
          type="button"
          aria-label="Search"
          aria-expanded="false"
          aria-controls="hdr-search"
          data-search-toggle
          class="flex size-11 items-center justify-center rounded-md text-[#F6F8F8] hover:bg-ink-800 aria-expanded:bg-ink-800"
        >
          <Icon name="search" size={20} stroke={2.2} />
        </button>
        <a href={PAGES.login} aria-label="Account" class="flex size-11 items-center justify-center rounded-md text-[#F6F8F8] hover:bg-ink-800 hover:text-[#F6F8F8]">
          <Icon name="user" size={20} />
        </a>
        <CartButton client:idle variant="desktop" />
      </div>
    </div>

    <!-- Search row -->
    <div id="hdr-search" hidden data-search-row class="border-t border-line-dark bg-ink-850">
      <div class="mx-auto max-w-[760px] px-10 py-4">
        <SearchBox client:idle variant="desktop" />
      </div>
    </div>

    <!-- Mega menu -->
    <div id="mega" hidden data-mega-panel class="absolute inset-x-0 top-full border-b border-line-dark bg-ink-850 shadow-menu">
      <div class="mx-auto grid max-w-(--container-page) grid-cols-[repeat(4,minmax(0,1fr))_minmax(0,1.25fr)] gap-8 px-10 pt-9 pb-10">
        {MEGA_COLUMNS.map((col) => (
          <div class="flex flex-col gap-7">
            {col.map((g) => {
              const h = menuHref(g.title);
              return (
                <div class="flex flex-col gap-3">
                  {h ? (
                    <a href={h} class="eyebrow text-cyan-400 no-underline hover:text-cyan-300">{g.title} →</a>
                  ) : (
                    <span class="eyebrow text-fog">{g.title}</span>
                  )}
                  <ul class="flex flex-col gap-0.5">
                    {g.items.map((it) => (
                      <li><a href={menuHref(it)} class="block py-1.5 text-[15px] font-semibold text-[#F6F8F8] no-underline hover:text-cyan-400">{it}</a></li>
                    ))}
                  </ul>
                </div>
              );
            })}
          </div>
        ))}
        <div class="flex flex-col gap-3">
          <a href={collectionUrl('clearance-sale')} class="flex flex-col gap-1.5 rounded-card border border-line-dark bg-ink-800 p-5 text-[#F6F8F8] no-underline hover:border-line-dark-strong hover:text-[#F6F8F8]">
            <span class="eyebrow text-sale-300">Clearance sale</span>
            <span class="text-[22px] leading-[26px] font-extrabold tracking-[-0.045em]">Marked-down booths and gear</span>
            <span class="text-[13px] font-extrabold text-cyan-400">Shop clearance →</span>
          </a>
          <div class="flex flex-col gap-2.5 rounded-card bg-cyan-400 p-5 text-ink-950">
            <span class="text-[22px] leading-[26px] font-extrabold tracking-[-0.045em]">Not sure which booth fits?</span>
            <span class="text-sm leading-5 text-teal-800">An expert can match a booth to your events and budget.</span>
            <a href={STORE.phoneHref} class="flex h-10 items-center gap-2 self-start rounded-md bg-ink-950 px-4 text-[13px] font-extrabold text-[#F6F8F8] no-underline hover:text-white">Call {STORE.phone}</a>
          </div>
        </div>
      </div>
    </div>
  </div>
  <div data-mega-scrim hidden class="fixed inset-0 -z-10 bg-ink-950/60 animate-fade-in"></div>

  <!-- Mobile rows -->
  <div class="border-b border-line-dark lg:hidden">
    <div class="flex h-[60px] items-center gap-0.5 px-2">
      <button type="button" aria-label="Open menu" aria-controls="mobile-menu" data-mobile-menu-open class="flex size-11 items-center justify-center rounded-md text-[#F6F8F8]">
        <Icon name="menu" size={24} stroke={2.2} />
      </button>
      <Logo size="sm" class="px-1" />
      <span class="flex-1"></span>
      <a href={STORE.phoneHref} aria-label={`Call ${STORE.phone}`} class="flex size-11 items-center justify-center rounded-full text-[#F6F8F8] hover:text-[#F6F8F8]">
        <Icon name="phone" size={20} />
      </a>
      <CartButton client:idle variant="mobile" />
    </div>
    <div class="px-4 pb-3">
      <SearchBox client:idle variant="mobile" />
    </div>
  </div>
</header>

<script>
  // Mega menu: click or hover-intent (150 ms) opens; Esc, outside click or
  // pointer leave (300 ms grace) closes.
  const root = document.querySelector<HTMLElement>('[data-mega-root]');
  const trigger = root?.querySelector<HTMLButtonElement>('[data-mega-trigger]');
  const panel = root?.querySelector<HTMLElement>('[data-mega-panel]');
  const scrim = document.querySelector<HTMLElement>('[data-mega-scrim]');
  const searchBtn = root?.querySelector<HTMLButtonElement>('[data-search-toggle]');
  const searchRow = root?.querySelector<HTMLElement>('[data-search-row]');

  const setSearch = (open: boolean) => {
    if (!searchBtn || !searchRow) return;
    searchBtn.setAttribute('aria-expanded', String(open));
    searchRow.hidden = !open;
    if (open) searchRow.querySelector<HTMLInputElement>('[data-header-search]')?.focus();
  };

  if (root && trigger && panel && scrim) {
    let timer: number | undefined;
    const set = (open: boolean) => {
      if (open) setSearch(false);
      trigger.setAttribute('aria-expanded', String(open));
      panel.hidden = !open;
      scrim.hidden = !open;
    };
    const isOpen = () => trigger.getAttribute('aria-expanded') === 'true';
    trigger.addEventListener('click', () => set(!isOpen()));
    const intent = (open: boolean, ms: number) => {
      window.clearTimeout(timer);
      timer = window.setTimeout(() => set(open), ms);
    };
    trigger.addEventListener('pointerenter', (e) => e.pointerType === 'mouse' && intent(true, 150));
    panel.addEventListener('pointerenter', () => window.clearTimeout(timer));
    root.addEventListener('pointerleave', (e) => e.pointerType === 'mouse' && isOpen() && intent(false, 300));
    scrim.addEventListener('click', () => set(false));
    document.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape') return;
      if (isOpen()) {
        set(false);
        trigger.focus();
      } else if (searchBtn?.getAttribute('aria-expanded') === 'true') {
        setSearch(false);
        searchBtn.focus();
      }
    });
  }
  searchBtn?.addEventListener('click', () => setSearch(searchBtn.getAttribute('aria-expanded') !== 'true'));
</script>
