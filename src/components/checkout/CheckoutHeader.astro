---
import Icon from '@/components/Icon.astro';
import { STORE } from '@/lib/commerce';
import { PAGES } from '@/lib/routes';

interface Props {
  /** return page: logo is not a link and there's no phone line (customer must not leave) */
  minimal?: boolean;
}
const { minimal = false } = Astro.props;
// v2 lockup on the light checkout header: camera mark + live wordmark with a teal full stop.
const mark = 'block size-7 lg:size-8';
const word = 'text-[18px] font-extrabold tracking-[-0.055em] whitespace-nowrap text-ink-900 lg:text-[20px]';
---

<header class="border-b border-line bg-surface">
  <div class="mx-auto flex h-16 max-w-[1440px] items-center justify-between gap-4 px-4 lg:h-20 lg:gap-6 lg:px-10">
    {
      minimal ? (
        <span class="flex items-center gap-2.5">
          <img src="/images/logo-mark.png" alt="" width="32" height="32" class={mark} />
          <span class={word}>Photobooth City<span class="text-focus">.</span></span>
        </span>
      ) : (
        <a href={PAGES.home} aria-label="Photobooth City home" class="flex items-center gap-2.5 no-underline">
          <img src="/images/logo-mark.png" alt="" width="32" height="32" class={mark} />
          <span class={word}>Photobooth City<span class="text-focus">.</span></span>
        </a>
      )
    }
    <div class="flex items-center gap-6 text-sm">
      <span class="flex items-center gap-1.5 text-[13px] font-bold text-success-700 lg:gap-2 lg:text-sm">
        <Icon name="lock" size={18} stroke={2.2} />
        <span class:list={[!minimal && 'lg:hidden']}>{minimal ? 'Secure checkout' : 'Secure'}</span>
        {!minimal && <span class="hidden lg:inline">Secure checkout</span>}
      </span>
      {
        !minimal && (
          <a href={STORE.phoneHref} class="hidden text-ink-900 no-underline hover:text-teal-700 lg:inline">
            Questions? <strong>{STORE.phone}</strong>
          </a>
        )
      }
    </div>
  </div>
</header>
