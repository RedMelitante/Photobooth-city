---
// Hero (dark, cyan glow) + product spotlight island + "Shop by format" bar.
import Icon from '@/components/Icon.astro';
import Spotlight from './Spotlight';
import { FORMATS, RATING, spotlightSlides } from '@/lib/home';
import { PAGES } from '@/lib/routes';

const slides = spotlightSlides();
// Format icons, inline from the board (24px grid, stroke 1.8).
const FORMAT_ICONS: Record<string, string> = {
  ipad: '<rect x="6" y="3" width="12" height="18" rx="2"/><path d="M11 18h2"/>',
  dslr: '<path d="M4 8h3l2-3h6l2 3h3v11H4z"/><circle cx="12" cy="13" r="3.5"/>',
  '360': '<path d="M20 12a8 8 0 0 1-13.7 5.7M4 12A8 8 0 0 1 17.7 6.3"/><path d="M18 2v4.5h-4.5M6 22v-4.5h4.5"/>',
  acc: '<rect x="3" y="7" width="18" height="13" rx="2"/><path d="M9 7V5a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2M3 12h18"/>',
};
---

<section aria-labelledby="hero-title" class="dark-band relative overflow-hidden bg-ink-950 text-[#F6F8F8]">
  <div aria-hidden="true" class="absolute inset-0 bg-[radial-gradient(60%_70%_at_72%_52%,rgba(116,237,245,0.13),rgba(116,237,245,0)_70%)]"></div>
  <div class="relative mx-auto flex max-w-[1440px] flex-wrap items-center gap-9 px-4 pt-10 pb-8 lg:gap-12 lg:px-10 lg:pt-[72px] lg:pb-14">
    <div class="flex min-w-0 flex-[1_1_520px] flex-col gap-[22px] lg:gap-[26px]">
      <span class="eyebrow flex items-center gap-2.5 text-fog">
        <span class="size-2 rounded-full bg-cyan-400 shadow-[0_0_0_3px_rgba(116,237,245,0.22)]" aria-hidden="true"></span>
        Professional photo booth equipment
      </span>
      <h1 id="hero-title" class="m-0 text-[60px] leading-[0.91] font-extrabold tracking-[-0.087em] lg:text-display-xl">
        Built for the<br /><span class="text-cyan-400">big shot.</span>
      </h1>
      <p class="m-0 max-w-[470px] text-base leading-[1.6] text-pretty text-fog lg:text-body-lg">
        From portable iPad booths to DSLR rigs and motorized 360 platforms. Find the gear for the events you run.
      </p>
      <div class="flex flex-wrap gap-2.5">
        <a href="#lineup" class="flex h-12 flex-auto items-center justify-center gap-2.5 rounded-md border border-cyan-400 whitespace-nowrap bg-cyan-400 px-[18px] text-sm font-extrabold text-ink-950 no-underline transition-colors hover:border-cyan-300 hover:bg-cyan-300 hover:text-ink-950 sm:flex-none">
          Explore the lineup <Icon name="arrow-right" size={16} stroke={2.4} />
        </a>
        <a href="#guide" class="flex h-12 flex-auto items-center justify-center rounded-md border border-line-dark-strong whitespace-nowrap px-[18px] text-sm font-extrabold text-[#F6F8F8] no-underline transition-colors hover:border-fog hover:text-[#F6F8F8] sm:flex-none">
          Find your format
        </a>
      </div>
      <ul aria-label="Why Photobooth City" class="m-0 mt-1.5 flex list-none flex-col gap-x-[26px] gap-y-3 border-t border-line-dark p-0 pt-[18px] text-[13px] leading-[18px] text-fog lg:flex-row lg:flex-wrap">
        <li class="flex items-center gap-2">
          <Icon name="star" size={15} class="text-cyan-400" />
          <a href={PAGES.reviews} class="font-extrabold text-[#F6F8F8] no-underline hover:text-cyan-400">{RATING.value} · {RATING.count} Google reviews</a>
        </li>
        <li class="flex items-center gap-2">
          <Icon name="clock" size={15} stroke={2.2} class="text-cyan-400" />
          <span>Experts <strong class="ml-1 font-extrabold text-[#F6F8F8]">Mon–Fri, 10–6 PT</strong></span>
        </li>
      </ul>
    </div>

    <Spotlight client:idle slides={slides} />
  </div>

  <nav aria-label="Shop by format" class="relative border-t border-line-dark bg-ink-850">
    <div class="mx-auto flex max-w-[1440px] snap-row px-4 lg:px-10">
      <span class="eyebrow hidden w-[168px] flex-none items-center border-r border-line-dark text-ink-300 lg:flex">Shop by<br />format</span>
      {FORMATS.map((f) => (
        <a href={f.h} class="group flex h-[60px] flex-[1_0_200px] items-center gap-3 border-r border-line-dark px-4 text-sm font-extrabold whitespace-nowrap text-[#F6F8F8] no-underline transition-colors hover:bg-ink-800 hover:text-[#F6F8F8] lg:h-[72px] lg:flex-[1_0_0] lg:px-7">
          <span class="flex text-cyan-400">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={FORMAT_ICONS[f.icon]} />
          </span>
          <span class="flex-1">{f.t}</span>
          <Icon name="arrow-right" size={15} stroke={2.2} class="text-[#87949A] transition-transform group-hover:translate-x-0.5" />
        </a>
      ))}
    </div>
  </nav>
</section>
