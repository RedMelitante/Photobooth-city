---
// 4.5-star rating row: four full stars and a half star (left half filled).
// `mobileFlat` renders the fifth star empty below lg, as on the mobile board.
interface Props {
  size: number;
  /** fill of the empty star / unfilled half */
  empty: string;
  gap?: string;
  mobileFlat?: boolean;
  class?: string;
}
const { size, empty, gap = 'gap-0.5', mobileFlat = false, class: className } = Astro.props;
const star = '<path d="M12 3l2.7 5.6 6.1.9-4.4 4.3 1 6.1L12 17l-5.4 2.9 1-6.1-4.4-4.3 6.1-.9z"/>';
---

<span role="img" aria-label="Rated 4.5 out of 5" class:list={['flex', gap, className]}>
  {[0, 1, 2, 3].map(() => <svg width={size} height={size} viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" set:html={star} />)}
  <span class:list={['relative block flex-none', mobileFlat && 'max-lg:hidden']} style={`width:${size}px;height:${size}px`}>
    <svg width={size} height={size} viewBox="0 0 24 24" fill={empty} class="absolute inset-0" aria-hidden="true" set:html={star} />
    <span class="absolute top-0 left-0 block overflow-hidden" style={`width:${size / 2}px;height:${size}px`}>
      <svg width={size} height={size} viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" set:html={star} />
    </span>
  </span>
  {mobileFlat && <svg width={size} height={size} viewBox="0 0 24 24" fill={empty} class="lg:hidden" aria-hidden="true" set:html={star} />}
</span>
