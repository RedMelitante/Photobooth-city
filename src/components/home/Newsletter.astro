---
// Flash sale + newsletter band (cyan). Code chip with Copy; the email form
// validates on submit, calls subscribeNewsletter() (src/lib/content-forms.ts)
// and swaps to a thank-you state.
import Icon from '@/components/Icon.astro';
import { PROMO } from '@/lib/commerce';
---

<section aria-labelledby="nl-title" class="bg-cyan-400 text-ink-950">
  <div class="mx-auto flex max-w-[1440px] flex-wrap items-center justify-between gap-7 px-4 py-11 lg:px-10 lg:py-16">
    <div class="flex flex-[1_1_420px] flex-col gap-3">
      <span class="eyebrow flex flex-wrap items-center gap-2 text-teal-800">
        Flash sale · code
        <code id="promo-code" class="rounded-xs bg-ink-950 px-[7px] py-0.5 font-[inherit] tracking-[0.06em] text-cyan-400">{PROMO.code}</code>
        <button
          type="button"
          data-copy-code={PROMO.code}
          aria-describedby="promo-code"
          class="eyebrow h-6 rounded-xs border border-ink-950 bg-transparent px-2 text-[10px] tracking-[0.08em] text-ink-950 transition-colors hover:bg-ink-950 hover:text-cyan-400"
        >
          <span data-copy-label>Copy</span>
        </button>
        <span class="sr-only" role="status" data-copy-status></span>
      </span>
      <h2 id="nl-title" class="m-0 text-[38px] leading-none font-extrabold tracking-[-0.065em] lg:text-[56px]">7% off orders $3,500+.</h2>
      <p class="m-0 text-[15px] leading-[1.55] text-teal-800">Applies to the whole order at checkout. Subscribe for the next sale and new booths.</p>
    </div>

    <form novalidate data-home-newsletter class="flex max-w-[520px] flex-[1_1_420px] flex-col gap-2">
      <label for="nl-email" class="text-[13px] font-extrabold">Email address</label>
      <div class="flex flex-wrap gap-2">
        <input
          id="nl-email"
          name="email"
          type="email"
          required
          placeholder="you@yourbusiness.com"
          autocomplete="email"
          aria-invalid="false"
          aria-describedby="nl-err"
          class="h-12 min-w-0 flex-[1_1_220px] rounded-md border border-ink-950 bg-surface px-3.5 text-[15px] text-ink-900 placeholder:text-ink-500"
        />
        <button type="submit" class="h-12 rounded-md border-0 bg-ink-950 px-5 text-sm font-extrabold text-[#F6F8F8] transition-colors hover:bg-ink-800 disabled:opacity-70">Subscribe</button>
      </div>
      <p id="nl-err" role="alert" class="m-0 text-[13px] font-extrabold text-[#8E1129] empty:hidden"></p>
    </form>

    <div role="status" data-home-newsletter-done hidden class="max-w-[520px] flex-[1_1_420px] items-start gap-3 rounded-card bg-ink-950 px-[18px] py-4 text-[#F6F8F8] [&:not([hidden])]:flex">
      <span aria-hidden="true" class="flex size-8 flex-none items-center justify-center rounded-full bg-cyan-400 text-ink-950">
        <Icon name="check" size={16} stroke={3} />
      </span>
      <span class="flex flex-col gap-0.5">
        <strong class="text-base">You’re on the list.</strong>
        <span class="text-sm leading-5 text-fog">We’ll send flash sales and new booths to <span data-newsletter-email></span>.</span>
      </span>
    </div>
  </div>
</section>

<script>
  import { EMAIL_RE, subscribeNewsletter } from '@/lib/content-forms';

  // Copy the promo code.
  for (const btn of document.querySelectorAll<HTMLButtonElement>('[data-copy-code]')) {
    const label = btn.querySelector('[data-copy-label]')!;
    const status = btn.parentElement?.querySelector('[data-copy-status]');
    let t: ReturnType<typeof setTimeout>;
    btn.addEventListener('click', async () => {
      const code = btn.dataset.copyCode!;
      try {
        await navigator.clipboard.writeText(code);
      } catch {
        // Clipboard blocked (http, old browser): select the code so it can be copied by hand.
        const el = document.getElementById(btn.getAttribute('aria-describedby') || '');
        if (el) getSelection()?.selectAllChildren(el);
      }
      label.textContent = 'Copied';
      if (status) status.textContent = `Code ${code} copied`;
      clearTimeout(t);
      t = setTimeout(() => {
        label.textContent = 'Copy';
        if (status) status.textContent = '';
      }, 2500);
    });
  }

  // Newsletter sign-up.
  const form = document.querySelector<HTMLFormElement>('[data-home-newsletter]');
  if (form) {
    const input = form.querySelector<HTMLInputElement>('input[type=email]')!;
    const submit = form.querySelector<HTMLButtonElement>('button[type=submit]')!;
    const err = form.querySelector<HTMLElement>('#nl-err')!;
    const done = document.querySelector<HTMLElement>('[data-home-newsletter-done]')!;
    const setError = (msg: string) => {
      input.setAttribute('aria-invalid', String(!!msg));
      err.textContent = msg;
    };
    input.addEventListener('input', () => setError(''));
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const v = input.value.trim();
      if (!EMAIL_RE.test(v)) {
        setError('Please enter a valid email address.');
        input.focus();
        return;
      }
      submit.disabled = true;
      try {
        await subscribeNewsletter(v);
      } catch {
        setError('Something went wrong. Please try again.');
        submit.disabled = false;
        return;
      }
      done.querySelector('[data-newsletter-email]')!.textContent = v;
      form.hidden = true;
      done.hidden = false;
    });
  }
</script>
