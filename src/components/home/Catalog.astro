---
// "Shop all products." (#lineup): heading + the filtering catalog island.
import Icon from '@/components/Icon.astro';
import HomeCatalog from './HomeCatalog';
import { CATALOG_CHIPS, CATALOG_LINKS, catalogCards, H2 } from '@/lib/home';
import { PAGES } from '@/lib/routes';

const cards = catalogCards();
---

<section id="lineup" aria-labelledby="cat-title" class="scroll-mt-4 bg-paper">
  <div class="mx-auto max-w-[1440px] px-4 py-14 lg:px-10 lg:py-24">
    <div class="mb-7 flex flex-wrap items-end justify-between gap-5">
      <div class="flex flex-col gap-3.5">
        <span class="eyebrow flex items-center gap-2.5 text-[#2B464E]"><span class="h-px w-5 bg-teal-700" aria-hidden="true"></span>The Photobooth City catalog</span>
        <h2 id="cat-title" class={H2}>Shop all products.</h2>
      </div>
      <a href={CATALOG_LINKS.browse} class="flex items-center gap-1.5 border-b border-ink-900 pb-1 text-sm font-extrabold text-ink-900 no-underline hover:border-teal-700 hover:text-teal-700">
        Browse products <Icon name="arrow-up-right" size={14} stroke={2.4} />
      </a>
    </div>
    <HomeCatalog client:idle cards={cards} chips={CATALOG_CHIPS} searchHref={PAGES.search} allHref={CATALOG_LINKS.all} />
  </div>
</section>
