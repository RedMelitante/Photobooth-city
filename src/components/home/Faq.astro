---
// FAQ accordion: native <details name="…"> — exclusive (one open at a time)
// with zero JS; the first item starts open as in the design.
import Icon from '@/components/Icon.astro';
import { FAQS, H2 } from '@/lib/home';
import { STORE } from '@/lib/commerce';
---

<section aria-labelledby="faq-title" class="container-page pt-12 lg:pt-24">
  <div class="grid grid-cols-1 lg:grid-cols-[340px_minmax(0,1fr)] lg:grid-rows-[auto_auto_auto_1fr] lg:gap-x-16 lg:gap-y-5">
    <h2 id="faq-title" class:list={[H2, 'mb-3 lg:mb-0']}>Frequently asked questions</h2>
    <p class="m-0 hidden text-body-lg leading-[27px] text-ink-700 lg:block">Still deciding? Our team helps new owners pick the right booth every day.</p>

    <div class="border-t border-line lg:col-start-2 lg:row-span-4 lg:row-start-1">
      {FAQS.map((f, i) => (
        <details name="home-faq" open={i === 0} class="group border-b border-line">
          <summary class="flex min-h-16 cursor-pointer list-none items-center justify-between gap-4 py-4 text-left text-ink-900 lg:gap-6 lg:py-6 [&::-webkit-details-marker]:hidden">
            <h3 class="m-0 text-base leading-[22px] font-bold lg:text-[19px] lg:leading-[26px]">{f.q}</h3>
            <span class="flex flex-none items-center justify-center transition-[transform,background-color,color] duration-150 group-open:rotate-180 lg:size-9 lg:rounded-full lg:bg-chip lg:text-ink-900 lg:group-open:bg-ink-900 lg:group-open:text-white" aria-hidden="true">
              <Icon name="chevron-down" size={20} stroke={2.4} class="lg:size-[18px]" />
            </span>
          </summary>
          <p class="m-0 pb-5 text-[15px] leading-6 text-pretty text-ink-700 lg:pr-16 lg:pb-7 lg:text-base lg:leading-[26px]">
            {f.a}{f.extra && <span class="max-lg:hidden"> {f.extra}</span>}
          </p>
        </details>
      ))}
    </div>

    <!-- Desktop help card -->
    <div class="hidden flex-col gap-3.5 self-start rounded-card bg-ink-950 p-6 text-white lg:col-start-1 lg:row-start-3 lg:flex">
      <span class="text-lg font-extrabold">Need help choosing?</span>
      <span class="text-[15px] leading-[22px] text-ink-200">Talk to a photo booth expert about your events, budget and setup.</span>
      <a href={STORE.phoneHref} class="flex h-12 items-center gap-2.5 self-start rounded-lg bg-flash-400 px-5 font-extrabold text-ink-950 transition-colors hover:bg-[#FFDB66] hover:text-ink-950">
        <Icon name="phone" size={18} stroke={2.2} />
        {STORE.phone}
      </a>
    </div>

    <!-- Mobile help link -->
    <a href={STORE.phoneHref} class="mt-5 flex items-center gap-3.5 rounded-card bg-ink-950 p-4 text-white hover:text-white lg:hidden">
      <span class="flex size-11 flex-none items-center justify-center rounded-full bg-flash-400 text-ink-950" aria-hidden="true">
        <Icon name="phone" size={20} stroke={2.2} />
      </span>
      <span class="flex flex-col gap-0.5">
        <span class="text-[15px] font-extrabold">Need help choosing?</span>
        <span class="text-sm text-ink-200">Call {STORE.phone}</span>
      </span>
    </a>
  </div>
</section>
