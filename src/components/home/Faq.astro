---
// "Get the right setup." — FAQ accordion. Native <details name="…"> keeps it
// exclusive (one open at a time) with zero JS; the first item starts open.
import Icon from '@/components/Icon.astro';
import { FAQS, H2 } from '@/lib/home';
import { PAGES } from '@/lib/routes';
import { STORE } from '@/lib/commerce';
---

<section aria-labelledby="faq-title" class="border-t border-line bg-paper">
  <div class="mx-auto flex max-w-[1440px] flex-wrap gap-9 px-4 py-14 lg:gap-16 lg:px-10 lg:py-24">
    <div class="flex max-w-[520px] flex-[1_1_400px] flex-col gap-[22px]">
      <span class="eyebrow flex items-center gap-2.5 text-[#2B464E]"><span class="h-px w-5 bg-teal-700" aria-hidden="true"></span>Before you order</span>
      <h2 id="faq-title" class={H2}>Get the right setup.</h2>
      <p class="m-0 max-w-[380px] text-[15px] leading-[1.6] text-ink-700">Tell the Photobooth City team what you shoot and what gear you already own.</p>
      <div class="flex flex-wrap items-center gap-[18px]">
        <a href={PAGES.contact} class="flex items-center gap-1.5 border-b border-ink-900 pb-1 text-sm font-extrabold text-ink-900 no-underline hover:border-teal-700 hover:text-teal-700">
          Contact the team <Icon name="arrow-up-right" size={14} stroke={2.4} />
        </a>
        <a href={STORE.phoneHref} class="text-sm font-extrabold text-teal-700 no-underline hover:text-teal-800 hover:underline">{STORE.phone}</a>
      </div>
    </div>

    <div class="min-w-0 flex-[999_1_520px] border-t border-line">
      {FAQS.map((f, i) => (
        <details name="home-faq" open={i === 0} class="group border-b border-line">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-5 py-[18px] text-left text-ink-900 [&::-webkit-details-marker]:hidden">
            <h3 class="m-0 text-[15px] leading-[22px] font-extrabold">{f.q}</h3>
            <Icon name="chevron-down" size={16} stroke={2.4} class="transition-transform duration-150 group-open:rotate-180" />
          </summary>
          <p class="m-0 pr-10 pb-5 text-sm leading-[1.65] text-pretty text-ink-700">{f.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>
