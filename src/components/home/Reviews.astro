---
// "Owners rate us 4.5." — five Google review cards with Read more.
import Icon from '@/components/Icon.astro';
import { GOOGLE_REVIEWS_URL, H2, RATING, REVIEWS } from '@/lib/home';
---

<section aria-labelledby="rev-title" class="bg-paper">
  <div class="mx-auto max-w-[1440px] px-4 py-14 lg:px-10 lg:py-24">
    <div class="mb-7 flex flex-wrap items-end justify-between gap-5">
      <div class="flex flex-col gap-3.5">
        <span class="eyebrow flex items-center gap-2.5 text-[#2B464E]"><span class="h-px w-5 bg-teal-700" aria-hidden="true"></span>Google reviews · {RATING.value} from {RATING.count}</span>
        <h2 id="rev-title" class={H2}>Owners rate us {RATING.value}.</h2>
      </div>
      <a href={GOOGLE_REVIEWS_URL} target="_blank" rel="noopener" class="flex items-center gap-1.5 border-b border-ink-900 pb-1 text-sm font-extrabold text-ink-900 no-underline hover:border-teal-700 hover:text-teal-700">
        Read all reviews on Google <Icon name="arrow-up-right" size={14} stroke={2.4} />
      </a>
    </div>

    <div class="-mx-4 snap-row scroll-px-4 gap-3.5 px-4 lg:mx-0 lg:grid lg:grid-cols-5 lg:overflow-visible lg:px-0">
      {REVIEWS.map((r, i) => {
        const canMore = r.short !== r.text;
        const textId = `rev-${i}`;
        return (
          <figure class="m-0 flex w-[280px] flex-none flex-col gap-4 rounded-card border border-[#D9E1E0] bg-surface p-5 lg:w-auto lg:min-w-0" data-review>
            <div role="img" aria-label="5 out of 5 stars" class="flex gap-0.5 text-ink-900">
              {[0, 1, 2, 3, 4].map(() => <Icon name="star" size={14} />)}
            </div>
            <blockquote id={textId} class="m-0 flex-1 text-[15px] leading-[1.55] text-pretty text-ink-900">
              {canMore ? (
                <>
                  <span data-short>“{r.short}”</span>
                  <span data-full hidden>“{r.text}”</span>
                </>
              ) : (
                <span>“{r.text}”</span>
              )}
            </blockquote>
            {canMore && (
              <button
                type="button"
                aria-expanded="false"
                aria-controls={textId}
                data-review-toggle
                class="self-start border-0 bg-transparent py-1 text-[13px] font-extrabold text-ink-900 underline hover:text-teal-700"
              >
                Read more
              </button>
            )}
            <figcaption class="flex items-center gap-2.5 border-t border-line pt-3.5">
              <img src={r.photo} alt="" width="34" height="34" loading="lazy" decoding="async" class="size-[34px] flex-none rounded-full bg-cyan-50 object-cover" />
              <span class="flex flex-col gap-0.5">
                <a href={r.gurl} target="_blank" rel="noopener" class="text-sm font-extrabold text-ink-900 no-underline hover:text-teal-700 hover:underline">{r.name}</a>
                <span class="font-mono text-[9px] font-semibold tracking-[0.08em] text-ink-500 uppercase">{r.when} · Google</span>
              </span>
            </figcaption>
          </figure>
        );
      })}
    </div>
  </div>
</section>

<script>
  for (const btn of document.querySelectorAll<HTMLButtonElement>('[data-review-toggle]')) {
    const fig = btn.closest('[data-review]')!;
    const short = fig.querySelector<HTMLElement>('[data-short]')!;
    const full = fig.querySelector<HTMLElement>('[data-full]')!;
    btn.addEventListener('click', () => {
      const open = btn.getAttribute('aria-expanded') !== 'true';
      btn.setAttribute('aria-expanded', String(open));
      short.hidden = open;
      full.hidden = !open;
      btn.textContent = open ? 'Show less' : 'Read more';
    });
  }
</script>
