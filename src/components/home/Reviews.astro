---
import Stars from './Stars.astro';
import { GOOGLE_REVIEWS_URL, RATING, REVIEWS } from '@/lib/home';
---

<section aria-labelledby="rev-title" class="mt-12 bg-canvas py-10 lg:mt-24 lg:py-0">
  <div class="container-page lg:py-[88px]">
    <div class="mb-5 flex flex-wrap items-center justify-between gap-6 lg:mb-9">
      <div class="flex items-center gap-3.5 lg:gap-6">
        <span class="font-display text-[52px] leading-none font-extrabold tracking-[-0.04em] lg:text-[80px]" aria-hidden="true">{RATING.value}</span>
        <div class="flex flex-col gap-1 lg:gap-2">
          <Stars size={18} empty="#D8DBE2" mobileFlat class="text-star lg:hidden" />
          <Stars size={24} empty="#D8DBE2" gap="gap-1" class="text-star max-lg:hidden" />
          <h2 id="rev-title" class="m-0 text-base font-bold lg:text-lg">Rated {RATING.value} on Google reviews</h2>
        </div>
      </div>
      <a href={GOOGLE_REVIEWS_URL} target="_blank" rel="noopener" class="hidden h-12 items-center rounded-lg border-[1.5px] border-ink-900 px-[22px] text-[15px] font-bold text-ink-900 transition-colors hover:bg-ink-900 hover:text-white lg:flex">Read all reviews on Google</a>
    </div>

    <div class="snap-row -mx-4 scroll-px-4 gap-3 px-4 pb-2 lg:mx-0 lg:scroll-px-0 lg:gap-5 lg:px-0 xl:grid xl:grid-cols-5 xl:overflow-visible xl:pb-0">
      {REVIEWS.map((r, i) => {
        const canMore = r.short !== r.text;
        const textId = `rev-${i}`;
        return (
          <figure class="m-0 flex flex-[0_0_280px] flex-col lg:flex-[0_0_300px] xl:min-w-0 gap-4 rounded-card bg-white p-5 lg:gap-[18px] lg:p-6 lg:shadow-xs" data-review>
            <blockquote id={textId} class="m-0 flex-1 text-[15px] leading-[23px] text-pretty text-ink-900 lg:text-base lg:leading-[25px]">
              {canMore ? (
                <>
                  <span data-short>“{r.short}”</span>
                  <span data-full hidden>“{r.text}”</span>
                </>
              ) : (
                <span>“{r.text}”</span>
              )}
            </blockquote>
            {canMore && (
              <button
                type="button"
                aria-expanded="false"
                aria-controls={textId}
                data-review-toggle
                class="self-start border-0 bg-transparent py-1.5 text-sm font-extrabold text-brand-600 underline hover:text-brand-700"
              >
                Read more
              </button>
            )}
            <figcaption class="flex items-center gap-2.5 lg:gap-3">
              <img
                src={r.photo}
                alt=""
                width="40"
                height="40"
                loading="lazy"
                decoding="async"
                class="size-9 flex-none rounded-full bg-brand-100 object-cover shadow-[0_0_0_2px_#FFFFFF,0_0_0_3px_var(--color-line)] lg:size-10"
              />
              <span class="flex flex-col gap-0.5">
                <a href={r.gurl} target="_blank" rel="noopener" class="text-sm font-bold text-ink-900 hover:text-ink-900 hover:underline lg:text-[15px]">{r.name}</a>
                <span class="text-xs text-ink-500 lg:text-[13px]">{r.when} · Google review</span>
              </span>
            </figcaption>
          </figure>
        );
      })}
    </div>

    <div class="pt-4 lg:hidden">
      <a href={GOOGLE_REVIEWS_URL} target="_blank" rel="noopener" class="flex h-12 items-center justify-center rounded-lg border-[1.5px] border-ink-900 text-[15px] font-bold text-ink-900 hover:text-ink-900">Read all reviews on Google</a>
    </div>
  </div>
</section>

<script>
  for (const btn of document.querySelectorAll<HTMLButtonElement>('[data-review-toggle]')) {
    const fig = btn.closest('[data-review]')!;
    const short = fig.querySelector<HTMLElement>('[data-short]')!;
    const full = fig.querySelector<HTMLElement>('[data-full]')!;
    btn.addEventListener('click', () => {
      const open = btn.getAttribute('aria-expanded') !== 'true';
      btn.setAttribute('aria-expanded', String(open));
      short.hidden = open;
      full.hidden = !open;
      btn.textContent = open ? 'Show less' : 'Read more';
    });
  }
</script>
