---
import ShopTheGuide from '@/components/content/ShopTheGuide.astro';
import type { Article } from '@/lib/content';
interface Props {
  article: Article;
}
const { article: a } = Astro.props;
const h2 = 'mt-12 mb-4 scroll-mt-6 font-display text-2xl leading-[1.15] font-bold tracking-[-0.02em] text-ink-900 lg:text-[30px]';
---
{a.blocks.map((b) => {
  switch (b.type) {
    case 'h2':
      return <h2 id={b.id} class={h2}>{b.text}</h2>;
    case 'h3':
      return <h3 class="mt-7 mb-2.5 text-lg leading-[1.3] font-extrabold text-ink-900 lg:text-xl">{b.text}</h3>;
    case 'li':
      return <p class="relative m-0 mb-1.5 pl-6"><span aria-hidden="true" class="absolute top-0 left-1.5 font-extrabold text-brand-600">•</span>{b.text}</p>;
    case 'calc':
      return <p class="mt-2 mb-5 rounded-card bg-flash-100 px-[22px] py-[18px] font-display text-2xl leading-[1.2] font-extrabold tracking-[-0.02em] text-ink-950 lg:text-[30px]">{b.text}</p>;
    case 'table':
      return (
        <div class="mt-2 mb-6 overflow-x-auto rounded-[14px] border border-line" tabindex="0" role="region" aria-label={`${b.head.join(', ')} table`}>
          <table class="w-full min-w-[520px] table-fixed border-collapse text-[15px] leading-[22px] lg:min-w-0">
            <colgroup>{b.widths.map((w) => <col style={`width:${(100 * w) / b.widths.reduce((x, y) => x + y, 0)}%`} />)}</colgroup>
            <thead>
              <tr class="bg-canvas">{b.head.map((h, i) => <th scope="col" class:list={['px-4 py-3 font-extrabold text-ink-900', b.align[i] === 'right' ? 'text-right' : 'text-left']}>{h}</th>)}</tr>
            </thead>
            <tbody>
              {b.rows.map((r) => (
                <tr class="border-t border-line bg-surface">{r.map((c, i) => <td class:list={['px-4 py-3 font-medium text-ink-900', b.align[i] === 'right' ? 'text-right' : 'text-left']}>{c}</td>)}</tr>
              ))}
            </tbody>
          </table>
        </div>
      );
    case 'shop':
      return <ShopTheGuide label={a.shop.label} items={a.shop.items} />;
    default:
      return <p class="m-0 mb-4">{b.text}</p>;
  }
})}
