---
// v2 brand lockup: camera mark + live wordmark with a cyan full stop.
interface Props { size?: 'sm' | 'md' | 'lg'; class?: string }
const { size = 'md', class: className } = Astro.props;
const mark = { sm: 28, md: 34, lg: 34 }[size];
const text = { sm: 'text-[18px]', md: 'text-[21px]', lg: 'text-[22px]' }[size];
---

<a href="/" aria-label="Photobooth City home" class:list={['flex items-center gap-2.5 text-white no-underline hover:text-white', className]}>
  <img src="/images/logo-mark.png" alt="" width={mark} height={mark} class="block" style={`width:${mark}px;height:${mark}px`} />
  <span class:list={[text, 'font-extrabold tracking-[-0.055em] whitespace-nowrap']}>Photobooth City<span class="text-cyan-400">.</span></span>
</a>
