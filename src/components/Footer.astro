---
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import { FOOTER_COLUMNS } from '@/lib/routes';
import { STORE } from '@/lib/commerce';

const socials = [
  ['Facebook', 'https://www.facebook.com/photoboothcity'],
  ['Instagram', 'https://www.instagram.com/myphotoboothcity/'],
  ['YouTube', 'https://www.youtube.com/channel/UCS1p7x2qLRKwtKgI8URavcQ'],
];
// Only methods checkout accepts: cards, plus PayPal once PayPal or Braintree is on.
const payments = ['Visa', 'Mastercard', 'Amex', 'Discover', ...(import.meta.env.PUBLIC_PAYPAL_CLIENT_ID || (import.meta.env.PUBLIC_BRAINTREE_ENABLED === 'true' && import.meta.env.PUBLIC_BRAINTREE_PAYPAL === 'true') ? ['PayPal'] : [])];
---

<footer class="dark-band w-full bg-ink-850 text-[#F6F8F8]">
  <div class="container-page flex flex-col gap-14 pt-[72px] pb-10 max-lg:px-5">
    <div class="flex flex-wrap gap-12">
      <div class="flex max-w-[400px] flex-[1_1_300px] flex-col gap-5">
        <Logo size="lg" class="self-start" />
        <p class="text-sm leading-[22px] text-fog">Professional equipment for photo booth businesses and event teams — entrepreneurs, DJs, photographers, planners and rental companies.</p>
        <div class="flex flex-col gap-2.5">
          <a href={STORE.phoneHref} class="flex items-center gap-2.5 text-lg font-extrabold text-white no-underline hover:text-white">
            <Icon name="phone" size={18} class="text-cyan-400" />{STORE.phone}
          </a>
          <a href={`mailto:${STORE.email}`} class="flex items-center gap-2.5 text-[15px] font-semibold text-white no-underline hover:text-white">
            <Icon name="mail" size={18} class="text-cyan-400" />{STORE.email}
          </a>
        </div>
        <ul aria-label="Social media" class="flex flex-wrap gap-2">
          {socials.map(([t, h]) => (
            <li><a href={h} target="_blank" rel="noopener" class="flex h-10 items-center rounded-sm border border-white/20 px-3.5 text-[13px] font-bold text-white no-underline hover:border-cyan-400 hover:text-white">{t}</a></li>
          ))}
        </ul>
      </div>
      <div class="grid min-w-0 flex-[999_1_560px] grid-cols-[repeat(auto-fit,minmax(min(150px,100%),1fr))] gap-8">
        {FOOTER_COLUMNS.map((c) => (
          <nav aria-label={c.title} class="flex flex-col gap-3.5">
            <span class="eyebrow text-ink-300">{c.title}</span>
            <ul class="flex flex-col gap-1">
              {c.links.map(([t, h]) => (
                <li><a href={h} class="block py-1.5 text-sm font-semibold text-[#DBE2E4] no-underline hover:text-cyan-400">{t}</a></li>
              ))}
            </ul>
          </nav>
        ))}
      </div>
    </div>
    <div class="flex flex-wrap items-center justify-between gap-5 border-t border-line-dark pt-7">
      <p class="text-[13px] text-ink-300">© {new Date().getFullYear()} Photobooth City. All rights reserved.</p>
      <ul aria-label="Accepted payment methods" class="flex flex-wrap gap-1.5">
        {payments.map((p) => (
          <li class="flex h-7 items-center rounded-xs border border-line-dark bg-ink-800 px-2.5 text-[11px] font-bold whitespace-nowrap text-[#DBE2E4]">{p}</li>
        ))}
      </ul>
    </div>
  </div>
</footer>
