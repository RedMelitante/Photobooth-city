---
import Layout from '@/layouts/Layout.astro';
import Icon from '@/components/Icon.astro';
import Breadcrumb from '@/components/content/Breadcrumb.astro';
import RichText from '@/components/content/RichText.astro';
import ScrollSpy from '@/components/content/ScrollSpy.astro';
import { listPolicies, policyUrl, type Policy } from '@/lib/content';

export function getStaticPaths() {
  return listPolicies().map((p) => ({ params: { policy: p.slug }, props: { policy: p } }));
}

interface Props {
  policy: Policy;
}
const { policy: d } = Astro.props;
const policies = listPolicies();
const description = d.intro || (d.glance.length ? d.glance.map((g) => `${g.value} ${g.label}`).join(' · ') : `${d.label} for photoboothcity.com.`);
---
<Layout title={d.label} description={description}>
  <div class="container-page pb-14 lg:pb-24">
    <Breadcrumb items={[{ label: 'Policies' }, { label: d.label }]} />

    <div class="flex flex-wrap items-start gap-5 lg:gap-14">
      <!-- SIDEBAR -->
      <aside class="flex min-w-0 flex-[1_1_100%] flex-col gap-6 lg:sticky lg:top-6 lg:max-h-[calc(100dvh-48px)] lg:flex-[0_0_280px]">
        <nav aria-label="Store policies" class="flex-none">
          <span class="mb-2.5 hidden text-eyebrow font-extrabold tracking-[0.1em] text-ink-500 uppercase lg:block">Store policies</span>
          <ul data-policy-switcher class="snap-row m-0 list-none gap-1.5 p-0 lg:flex-col lg:overflow-visible">
            {policies.map((p) => {
              const on = p.key === d.key;
              return (
                <li class="flex-none">
                  <a
                    href={policyUrl(p.key)}
                    aria-current={on ? 'page' : undefined}
                    class:list={[
                      'flex min-h-11 w-full items-center rounded-full border-[1.5px] px-3.5 text-sm font-bold whitespace-nowrap no-underline lg:rounded-md',
                      on ? 'border-ink-900 bg-ink-900 text-white hover:text-white' : 'border-line-strong bg-surface text-ink-900 hover:bg-chip hover:text-ink-900 lg:border-transparent',
                    ]}
                  >{p.label}</a>
                </li>
              );
            })}
          </ul>
        </nav>
        <nav aria-label="On this page" data-scrollspy class="hidden min-h-0 flex-col rounded-card bg-canvas p-[18px] lg:flex">
          <span class="mb-2 block text-[13px] font-extrabold">On this page</span>
          <ol data-scrollspy-box class="m-0 flex min-h-0 list-none flex-col gap-0.5 overflow-y-auto p-0">
            {d.sections.map((s) => (
              <li><a href={`#${s.id}`} class="block py-[5px] text-[13px] leading-[18px] text-ink-700 no-underline hover:text-ink-900 data-[active]:font-bold data-[active]:text-ink-900">{s.heading}</a></li>
            ))}
          </ol>
        </nav>
      </aside>

      <!-- CONTENT -->
      <article class="min-w-0 max-w-[820px] flex-[999_1_560px]">
        <h1 class="m-0 font-display text-[38px] leading-none font-extrabold tracking-[-0.035em] lg:text-[56px]">{d.label}</h1>
        {d.intro && <p class="mt-3.5 mb-0 max-w-[720px] text-body-lg leading-7 text-ink-700">{d.intro}</p>}

        {d.glance.length > 0 && (
          <section aria-label="At a glance" class="mt-7 rounded-panel bg-brand-50 p-5">
            <span class="mb-3.5 block text-eyebrow font-extrabold tracking-[0.1em] text-brand-700 uppercase">At a glance</span>
            <ul class="m-0 grid list-none grid-cols-1 gap-2.5 p-0 sm:grid-cols-2">
              {d.glance.map((g) => (
                <li class="flex flex-col gap-1 rounded-[14px] bg-surface p-3.5"><strong class="font-display text-2xl leading-[1.1] tracking-[-0.02em]">{g.value}</strong><span class="text-[13px] leading-[18px] text-ink-700">{g.label}</span></li>
              ))}
            </ul>
          </section>
        )}

        <div class="mt-4">
          {d.sections.map((s) => (
            <section id={s.id} aria-labelledby={`${s.id}-h`} class="scroll-mt-6 border-b border-line py-[26px]">
              <h2 id={`${s.id}-h`} class="m-0 mb-2.5 text-lg leading-[1.3] font-extrabold lg:text-xl">{s.heading}</h2>
              {s.blocks.map((b) => {
                switch (b.type) {
                  case 'sub':
                    return <h3 class="mt-[18px] mb-2 text-base leading-6 font-extrabold text-ink-900">{b.text}</h3>;
                  case 'li':
                    return <p class="relative m-0 mb-2 pl-[22px] text-base leading-[26px] text-ink-700"><span aria-hidden="true" class="absolute top-0 left-1.5 font-extrabold text-brand-600">•</span><RichText text={b.text} /></p>;
                  case 'xli':
                    return <p class="m-0 mb-2 flex items-start gap-2.5 rounded-md bg-sale-50 px-3 py-2.5 text-[15px] leading-[22px] font-bold text-[#8E1129]"><Icon name="close" size={16} stroke={2.6} class="mt-[3px]" /><span><span class="sr-only">Not returnable: </span>{b.text}</span></p>;
                  case 'kv':
                    return <p class="m-0 flex flex-wrap gap-x-4 gap-y-1 border-b border-line py-2.5 text-[15px] leading-[22px]"><code class="flex-[0_0_200px] font-mono text-sm font-bold text-ink-900">{b.key}</code><span class="flex-[1_1_240px] text-ink-700"><RichText text={b.text} /></span></p>;
                  case 'note':
                    return <p class="m-0 mb-3 rounded-md border border-dashed border-[#B88400] bg-flash-100 px-3 py-2.5 text-sm leading-[21px] text-[#5C4300]"><strong class="block text-[11px] tracking-[0.08em] uppercase">Unfinished on the live site</strong><RichText text={b.text} /></p>;
                  default:
                    return <p class="m-0 mb-3 text-base leading-[26px] text-ink-700"><RichText text={b.text} /></p>;
                }
              })}
            </section>
          ))}
        </div>

        <section aria-labelledby="pc" class="mt-8 flex flex-col gap-3.5 rounded-panel bg-ink-950 p-5 text-white lg:p-7">
          <h2 id="pc" class="m-0 text-xl font-extrabold">Questions about this policy?</h2>
          <ul class="m-0 flex list-none flex-col gap-2.5 p-0 text-[15px]">
            {d.contacts.map((c) => (
              <li class="flex flex-wrap gap-x-2.5 gap-y-1">
                <span class="text-ink-200">{c.label}</span>
                {c.href ? <a href={c.href} class="font-extrabold break-all text-white hover:text-ink-200">{c.value}</a> : <span class="font-extrabold">{c.value}</span>}
              </li>
            ))}
          </ul>
        </section>
      </article>
    </div>
  </div>
  <ScrollSpy />
</Layout>

<script>
  // Mobile: the switcher is a horizontal row; bring the current policy into view.
  const row = document.querySelector<HTMLElement>('[data-policy-switcher]');
  const current = row?.querySelector<HTMLElement>('[aria-current="page"]');
  if (row && current && row.scrollWidth > row.clientWidth) {
    row.scrollLeft = current.parentElement!.offsetLeft - row.offsetLeft - 16;
  }
</script>
