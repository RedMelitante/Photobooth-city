---
import Layout from '@/layouts/Layout.astro';
import Icon from '@/components/Icon.astro';
import Breadcrumb from '@/components/content/Breadcrumb.astro';
import { ABOUT, REVIEWS, img } from '@/lib/content';
import { PAGES, collectionUrl, BOARD_URLS } from '@/lib/routes';
import { STORE } from '@/lib/commerce';
import { designImage } from '@/lib/catalog';

const CATEGORY_LINKS = [collectionUrl('ipad-booths'), collectionUrl('dslr-booths'), collectionUrl('360-booths'), collectionUrl('system-packages')];
const shopHref = BOARD_URLS.CollectionDesktop;
---
<Layout title="About Us" description="Photobooth City sells iPad, DSLR and 360 photo booths, DIY shells, complete systems and accessories to event businesses across the US.">
  <div class="container-page">
    <Breadcrumb items={[{ label: 'About Us' }]} />

    <!-- HERO -->
    <section aria-labelledby="about-title" class="flex flex-wrap items-stretch gap-6 lg:gap-12">
      <div class="flex min-w-0 flex-[1_1_480px] flex-col justify-center gap-[22px] lg:py-6">
        <span class="text-eyebrow font-extrabold tracking-[0.12em] text-brand-600 uppercase">About Photobooth City</span>
        <h1 id="about-title" class="m-0 font-display text-[38px] leading-none font-extrabold tracking-[-0.035em] text-balance lg:text-[64px]">Professional photo booth equipment for event businesses</h1>
        <p class="m-0 text-base leading-[1.6] text-pretty text-ink-700 lg:text-[19px]">We sell iPad, DSLR and 360 photo booths, DIY shells, complete systems and accessories to entrepreneurs, DJs, photographers, venues and event businesses that run their own photo booth services.</p>
        <p class="m-0 flex gap-2.5 rounded-lg bg-brand-50 px-4 py-3.5 text-sm leading-[21px] font-semibold text-brand-700">
          <Icon name="info" size={18} class="mt-px" />
          Looking to rent a booth for your event? We sell equipment only — we don’t book photo booth rentals.
        </p>
        <div class="flex flex-wrap gap-3">
          <a href={shopHref} class="flex h-[54px] flex-[1_1_100%] items-center justify-center rounded-lg bg-brand-600 px-[26px] text-base font-extrabold text-white no-underline hover:bg-brand-700 hover:text-white sm:flex-none">Shop photo booths</a>
          <a href={STORE.phoneHref} class="flex h-[54px] flex-[1_1_100%] items-center justify-center rounded-lg border-[1.5px] border-ink-900 px-[22px] text-base font-extrabold text-ink-900 no-underline hover:bg-chip hover:text-ink-900 sm:flex-none">Talk to an expert</a>
        </div>
      </div>
      <div class="relative min-h-[240px] flex-[1_1_480px] rounded-hero bg-tile bg-[repeating-linear-gradient(135deg,rgba(11,16,32,0.035)_0_2px,transparent_2px_16px)] lg:min-h-[480px]">
        <img src={designImage('/_blob/7e58d5c4bae69404b65c8e096d2f3764')} alt="Photobooth City booth line-up: ring light, wooden, DSLR and LED ring photo booths" fetchpriority="high" class="absolute inset-0 h-full w-full rounded-hero object-cover object-[18%_center]" />
      </div>
    </section>

    <!-- CATEGORIES -->
    <section aria-labelledby="find-title" class="pt-14 lg:pt-24">
      <h2 id="find-title" class="m-0 mb-6 font-display text-[28px] leading-[1.1] font-bold tracking-[-0.025em] lg:text-[40px]">Find the right photo booth equipment</h2>
      <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-4 lg:gap-5">
        {ABOUT.categories.map((c, i) => (
          <a href={CATEGORY_LINKS[i] ?? shopHref} class="group flex flex-col gap-3 rounded-panel border border-line p-5 text-ink-900 no-underline transition-colors hover:border-line-strong hover:text-ink-900 lg:p-7">
            <span class="block h-[180px] overflow-hidden rounded-[14px] bg-canvas"><img src={img(c.image)} alt="" loading="lazy" class="product-shot block h-full w-full p-2 transition-transform duration-300 group-hover:scale-[1.03]" /></span>
            <span class="font-display text-xl leading-[1.15] font-bold lg:text-2xl">{c.name}</span>
            <span class="text-sm leading-5 text-ink-700">{c.sub}</span>
            <span class="mt-auto text-sm font-extrabold text-brand-600">Shop →</span>
          </a>
        ))}
      </div>
    </section>

    <!-- CHOOSE A SETUP -->
    <section aria-labelledby="setup-title" class="flex flex-wrap gap-6 pt-14 lg:gap-12 lg:pt-24">
      <div class="flex min-w-0 flex-[999_1_560px] flex-col gap-5">
        <h2 id="setup-title" class="m-0 font-display text-[28px] leading-[1.1] font-bold tracking-[-0.025em] lg:text-[40px]">Choose a setup that fits your business</h2>
        <ul class="m-0 grid list-none grid-cols-[repeat(auto-fit,minmax(min(280px,100%),1fr))] gap-3 p-0">
          {ABOUT.checklist.map((c) => (
            <li class="flex gap-3.5 rounded-card bg-canvas p-[18px]">
              <span class="flex size-7 flex-none items-center justify-center rounded-full bg-success-700 text-white"><Icon name="check" size={14} stroke={3} /></span>
              <span class="flex flex-col gap-1"><strong class="text-[15px]">{c.title}</strong><span class="text-sm leading-[21px] text-ink-700">{c.text}</span></span>
            </li>
          ))}
        </ul>
      </div>
      <aside aria-labelledby="unsure-title" class="flex flex-[1_1_340px] flex-col gap-4 rounded-hero bg-ink-950 px-5 py-6 text-white lg:p-10">
        <h3 id="unsure-title" class="m-0 font-display text-[28px] leading-8 font-bold">Not sure which model fits?</h3>
        <p class="m-0 text-[15px] leading-[23px] text-ink-200">Tell our team three things and we’ll point you to the right booth:</p>
        <ol class="m-0 flex list-none flex-col gap-2.5 p-0">
          {['The events you serve', 'The devices you plan to use', 'The features you need'].map((t, i) => (
            <li class="flex items-center gap-3 font-bold"><span class="flex size-7 flex-none items-center justify-center rounded-full bg-flash-400 text-[13px] font-extrabold text-ink-950">{i + 1}</span>{t}</li>
          ))}
        </ol>
        <a href={PAGES.contact} class="mt-2 flex h-[52px] items-center justify-center rounded-lg bg-flash-400 font-extrabold text-ink-950 no-underline hover:bg-[#ffdb66] hover:text-ink-950">Contact our team</a>
        <a href={STORE.phoneHref} class="text-center text-[15px] font-bold text-white hover:text-ink-200">or call {STORE.phone}</a>
      </aside>
    </section>

    <!-- REVIEWS -->
    <section aria-labelledby="ab-rev" class="pt-14 lg:pt-24">
      <div class="mb-6 flex flex-wrap items-center justify-between gap-5">
        <div class="flex items-center gap-4">
          <span class="font-display text-[56px] leading-none font-extrabold tracking-[-0.04em]">{REVIEWS.rating}</span>
          <h2 id="ab-rev" class="m-0 text-lg leading-6 font-extrabold">Rated {REVIEWS.rating} on Google<br /><span class="text-sm font-medium text-ink-500">by photo booth business owners</span></h2>
        </div>
        <div class="flex flex-wrap gap-2.5">
          <a href={REVIEWS.writeReviewUrl} target="_blank" rel="noopener" class="flex h-12 items-center rounded-lg bg-ink-900 px-5 font-bold text-white no-underline hover:bg-ink-700 hover:text-white">Leave a Review</a>
          <a href={REVIEWS.allReviewsUrl} target="_blank" rel="noopener" class="flex h-12 items-center rounded-lg border-[1.5px] border-ink-900 px-5 font-bold text-ink-900 no-underline hover:bg-chip hover:text-ink-900">Read All Reviews</a>
        </div>
      </div>
      <div class="grid grid-cols-[repeat(auto-fit,minmax(min(300px,100%),1fr))] gap-4">
        {REVIEWS.aboutQuotes.map((r) => (
          <figure class="m-0 flex flex-col gap-4 rounded-card border border-line p-6">
            <blockquote class="m-0 flex-1 text-base leading-[25px]">“{r.text}”</blockquote>
            <figcaption class="text-sm text-ink-500"><strong class="text-ink-900">{r.name}</strong> · {r.when}</figcaption>
          </figure>
        ))}
      </div>
    </section>

    <!-- CONTACT BAND -->
    <section aria-labelledby="ab-talk" class="my-14 flex flex-wrap items-center justify-between gap-5 rounded-hero bg-brand-600 px-5 py-6 text-white lg:my-24 lg:p-10">
      <h2 id="ab-talk" class="m-0 font-display text-[28px] leading-[1.1] font-bold tracking-[-0.02em] lg:text-[40px]">Talk to the team</h2>
      <div class="flex flex-wrap gap-3">
        <a href={STORE.phoneHref} class="flex h-[52px] items-center gap-2.5 rounded-lg bg-flash-400 px-5 font-extrabold text-ink-950 no-underline hover:bg-[#ffdb66] hover:text-ink-950">{STORE.phone}</a>
        <a href={`mailto:${STORE.email}`} class="flex h-[52px] items-center rounded-lg border-[1.5px] border-white/50 px-5 font-bold break-all text-white no-underline hover:border-white hover:text-white">{STORE.email}</a>
      </div>
    </section>
  </div>
</Layout>
