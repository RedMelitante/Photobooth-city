{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "npm run build",
    "watchPatterns": ["/src/**", "/public/**", "/scripts/**", "/package.json", "/astro.config.mjs"]
  },
  "deploy": {
    "startCommand": "npx --yes serve@14.2.4 dist -l tcp://0.0.0.0:${PORT:-8080} --no-clipboard",
    "healthcheckPath": "/",
    "restartPolicyType": "ON_FAILURE"
  }
}
